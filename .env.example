# Copy to .env and fill in. Never commit .env.

# --- LLM API keys ---
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# --- Models ---
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# Judge for RAGAS + adversarial scoring (a third model, not under test).
JUDGE_MODEL=claude-haiku-4-5-20251001

# --- Retrieval ---
TOP_K=8
# Top chunk below this relevance score triggers an out-of-scope refusal.
# Provisional: Day 3-5 sanity check showed in-scope ~0.62-0.73, out-of-scope
# ~0.42-0.46. Calibrated against the golden set during evaluation (Days 8-10).
RELEVANCE_THRESHOLD=0.50

# --- Storage paths (relative to repo root) ---
LANCEDB_URI=data/lancedb
LANCEDB_TABLE=htn_chunks

# --- MLflow ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT=clinrag-htn
